# ═══════════════════════════════════════════════════════════
# Numerical Methods Calculator — Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and update values for your environment.
#   cp .env.example .env

# ── Flask ─────────────────────────────────────────────────
FLASK_ENV=production
SECRET_KEY=CHANGE-ME-generate-with-python-c-import-secrets-secrets-token-hex-32

# ── Database ──────────────────────────────────────────────
# SQLite (default, stored in Docker volume)
DATABASE_URL=sqlite:////app/instance/numcalc.db

# ── Gunicorn ──────────────────────────────────────────────
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info

# ── Nginx ─────────────────────────────────────────────────
NGINX_PORT=80
